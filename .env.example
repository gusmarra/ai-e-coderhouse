# Copiar a .env y completar. El .env real esta en .gitignore: nunca se sube.

# openai | gemini. Si se deja vacio, se usa el primero que tenga API key.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
# GOOGLE_API_KEY=
OPENAI_API_KEY=

# Opcionales
# LLM_MODEL=gemini-3.5-flash-lite
# CHECKPOINT_DB=checkpoints.sqlite
# Tope de requests por minuto al LLM (free tier de Gemini: 5 por minuto -> usar 4).
# LLM_RPM=4
