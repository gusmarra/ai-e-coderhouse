# Copiar a .env y completar solo la key del proveedor que se vaya a usar.
# Mismos nombres de variables que el Modulo 1.

# Proveedor por defecto de crear_modelo(): openai | anthropic | gemini
# Si se deja vacio, se usa el primero que tenga API key en el entorno.
LLM_PROVIDER=gemini

# Opcional: pisa el modelo por defecto de ese proveedor.
# LLM_MODEL=gemini-3.5-flash-lite

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gemini acepta cualquiera de las dos (GEMINI_API_KEY tiene prioridad).
GEMINI_API_KEY=
# GOOGLE_API_KEY=
