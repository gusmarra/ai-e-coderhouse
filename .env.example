# Copiar a .env y completar. El .env real esta en .gitignore: nunca se sube.

# --- LLM -------------------------------------------------------------------
# openai | gemini. Si se deja vacio, se usa el primero que tenga API key.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite
# Tope de requests por minuto al LLM (free tier de Gemini: 5 por minuto -> usar 4).
# LLM_RPM=4

# --- Redis (estado de los jobs + checkpoints de LangGraph) --------------------
# Tiene que ser Redis Stack (RediSearch + RedisJSON): docker compose up -d redis
REDIS_URL=redis://localhost:6379/0
# Tareas que el worker corre en paralelo; el resto espera en la cola.
WORKER_CONCURRENCIA=5
# Segundos maximos por ejecucion antes de marcar el job como FAILED.
JOB_TIMEOUT_S=300

# --- Observabilidad -----------------------------------------------------------
# phoenix | langsmith | none
OBSERVABILITY=phoenix
OBSERVABILITY_PROJECT=orquestador-hotel
# Phoenix local (docker compose up -d phoenix). Dashboard en http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# Si usas LangSmith en vez de Phoenix:
# OBSERVABILITY=langsmith
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=orquestador-hotel

# --- Opcional: busqueda hibrida (BM25 + vectorial) sobre Pinecone --------------
# Sin esta key el investigador usa solo BM25 local sobre app/data/.
# PINECONE_API_KEY=
# INDEX_NAME=hotel-bahia-serena
