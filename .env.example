# Copiar a .env y completar. El .env real esta en .gitignore: nunca se sube.

# --- Pinecone (obligatorio) ---------------------------------------------
PINECONE_API_KEY=
# Nombre del indice serverless: setup_pinecone.py lo crea si no existe.
INDEX_NAME=hotel-bahia-serena
# Opcionales (defaults entre parentesis). El plan gratuito solo admite aws/us-east-1.
# PINECONE_NAMESPACE=hotel-bahia-serena
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# --- Proveedor de embeddings y LLM (alcanza con uno) --------------------
# openai | gemini. Si se deja vacio, se usa el primero que tenga API key.
LLM_PROVIDER=gemini

OPENAI_API_KEY=

# Gemini acepta cualquiera de las dos (GEMINI_API_KEY tiene prioridad).
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Opcionales: pisan el modelo por defecto. IMPORTANTE: EMBEDDING_MODEL tiene que
# ser el mismo en la ingesta y en la consulta, o la distancia vectorial deja de
# tener sentido (y si cambias de proveedor, hay que reingestar con --reset).
# LLM_MODEL=gemini-3.5-flash-lite
# EMBEDDING_MODEL=models/gemini-embedding-001
