# Copiar a .env y completar solo la key del proveedor que se vaya a usar.
# Mismos nombres de variables que las entregas anteriores.

# Proveedor por defecto de crear_modelo()/crear_embeddings(): openai | gemini
# (Anthropic no ofrece API de embeddings, por eso no es una opcion aca.)
# Si se deja vacio, se usa el primero que tenga API key en el entorno.
LLM_PROVIDER=gemini

# Opcionales: pisan el modelo por defecto de ese proveedor. IMPORTANTE:
# EMBEDDING_MODEL tiene que ser el mismo en la ingesta y en la consulta, o la
# distancia vectorial deja de tener sentido (ver README, "Embeddings no
# coincidentes").
# LLM_MODEL=gemini-3.5-flash-lite
# EMBEDDING_MODEL=models/gemini-embedding-001

OPENAI_API_KEY=

# Gemini acepta cualquiera de las dos (GEMINI_API_KEY tiene prioridad).
GEMINI_API_KEY=
# GOOGLE_API_KEY=
